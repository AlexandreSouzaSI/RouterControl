generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TruckRule {
  id         String @id @default(uuid())
  caminhaoId String @unique

  origemViagem  String?
  origemViagem2 String?
  destinoViagem String?
  cidadeParado  String?

  caminhao Caminhao @relation(fields: [caminhaoId], references: [id])
}

model Upload {
  id          String   @id @default(uuid())
  nomeArquivo String
  mes         String
  createdAt   DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadPeriods UploadPeriod[]

  resumos ResumoOperacao[]
}

model Caminhao {
  id    String  @id @default(uuid())
  ativo Boolean @default(true)
  placa String  @unique

  // Capacidade do tanque em litros — cadastro manual, opcional. Sem isso
  // não dá pra converter "está com X% do tanque" (o que a Telemetria
  // manda) em "quantos km ele ainda roda" — o percentual sozinho não diz
  // nada sobre litros/km sem saber o tamanho do tanque desse caminhão.
  capacidadeTanqueLitros Float?

  // Dono do caminhão pro módulo Financeiro/NF (Fornecedor, Conta a Pagar,
  // NF de Entrada/Serviço) e demais módulos que passarem a filtrar por
  // empresa. Fica opcional por enquanto (retrofit): caminhões cadastrados
  // antes dessa migração ficam sem empresa até alguém preencher — ver
  // instruções de backfill no fim do schema.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  uploadPeriods       UploadPeriod[]
  tripRecords         TripRecord[]
  stopRecords         StopRecord[]
  resumos             ResumoOperacao[]
  relatorioPagamentos RelatorioPagamento[]
  truckRules          TruckRule[]
  Upload              Upload[]

  transacoesFinanceiras TransacaoFinanceira[]
  regrasFinanceiras     RegraClassificacaoFinanceira[]

  truckStatus     TruckStatus?
  configPagamento ConfiguracaoPagamentoCaminhao?

  rpaRecibos    RpaRecibo[]
  ciotRegistros CiotRegistro[]

  nfEntradas  NfEntrada[]
  nfServicos  NfServico[]
  contasPagar ContaPagar[]

  @@index([empresaId])
}

model ResumoOperacao {
  id            String   @id @default(uuid())
  mes           String
  numeroViagens Int
  diasParados   Int
  diasRodando   Int
  createdAt     DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadId String?
  upload   Upload? @relation(fields: [uploadId], references: [id])
}

model Motorista {
  id    String  @id @default(uuid())
  nome  String
  ativo Boolean @default(true)
}

// Módulos que uma empresa pode ou não ter habilitados — controlado só
// pelo Admin Master (Quadro do Administrador), não pela própria empresa.
// RASTREADOR cobre Dashboard/Viagens/Rotas/Dados Capturados (tudo que
// depende da credencial da Trucks Control); FISCAL cobre RPA/CIOT;
// FINANCEIRO_NF cobre NF de Entrada/Serviço + Contas a Pagar.
enum EmpresaModulo {
  RASTREADOR
  FISCAL
  FINANCEIRO_NF
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  createdAt DateTime @default(now())

  // CNPJ da empresa — usado pra identificar o destinatário nas consultas
  // de distribuição da Sefaz/ADN (NF-e de compra e NFS-e de serviço) e
  // pra futuras validações no módulo Financeiro/NF.
  cnpj String?

  // Telefone de contato da empresa — não existia antes; útil pra suporte e
  // pra eventuais avisos, sem relação com o CNPJ/dados fiscais abaixo.
  telefone String?

  // Endereço estruturado + Inscrição Estadual — exigido pra emitir/consultar
  // NF-e própria e pra distribuição via Sefaz (cUFAutor depende da UF real
  // da empresa; antes disso o módulo Financeiro/NF usava um código fixo de
  // UF "91" — Ambiente Nacional — por falta desse campo). Mesma pegada de
  // campos do Store do Controle NF (schema.prisma daquele projeto), só que
  // aqui pertence à Empresa (tenant), não a uma loja física.
  uf                  String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  municipio           String?
  codigoMunicipioIbge String?
  cep                 String?
  inscricaoEstadual   String?

  // Controle do Admin Master (Quadro do Administrador) — nada disso é
  // editável pela própria empresa. "ativo = false" bloqueia login (checado
  // no login e em toda requisição via JwtStrategy). "pagamentoEmDia" é só
  // informativo por enquanto — não bloqueia sozinho, é o admin quem decide
  // marcar a empresa como inativa se quiser cortar o acesso por atraso.
  ativo              Boolean         @default(true)
  pagamentoEmDia     Boolean         @default(true)
  observacoesAdmin   String?
  modulosHabilitados EmpresaModulo[] @default([RASTREADOR, FISCAL, FINANCEIRO_NF])

  usuarios               Usuario[]
  viagens                Viagem[]
  configuracaoPagamentos ConfiguracaoPagamento[]

  caminhoes Caminhao[]

  fornecedores         Fornecedor[]
  categoriasContaPagar CategoriaContaPagar[]
  contasPagar          ContaPagar[]
  nfEntradas           NfEntrada[]
  nfServicos           NfServico[]

  certificadoDigital     CertificadoDigitalEmpresa?
  sefazSincronizacaoLogs SefazSincronizacaoLog[]

  rpaRecibos    RpaRecibo[]
  ciotRegistros CiotRegistro[]

  trucksControlCredencial TrucksControlCredencial?
  veiculosTrucksControl   VeiculoTrucksControl[]
  trucksControlRateLimits TrucksControlRateLimit[]
  posicoesCaminhao        PosicaoCaminhao[]
  viagensGps              ViagemGps[]
  telemetriaOcorrencias   TelemetriaOcorrencia[]
  telemetriaBlocosV25     TelemetriaBlocoV25[]

  // Retrofit de isolamento por empresa do módulo Financeiro (extrato
  // bancário), Pagamentos e Relatórios/Upload — ver comentário em cada
  // campo empresaId abaixo pra entender por que ficam opcionais.
  importacoesExtrato             ImportacaoExtrato[]
  transacoesFinanceiras          TransacaoFinanceira[]
  categoriasFinanceiras          CategoriaFinanceira[]
  regrasClassificacaoFinanceira  RegraClassificacaoFinanceira[]
  configuracaoPagamentoMotorista ConfiguracaoPagamentoMotorista?

  lancamentosCaminhao LancamentoCaminhao[]
}

// Perfil dentro da própria empresa (não confundir com isAdminMaster, que é
// o dono do sistema todo, acima de qualquer empresa). ADMIN gerencia os
// colaboradores da empresa (aba Colaboradores em Cadastros); PROPRIETARIO
// e FUNCIONARIO por enquanto têm o mesmo acesso operacional de ADMIN a
// tudo mais no sistema — só a gestão de colaboradores é restrita a ADMIN.
enum PerfilUsuario {
  ADMIN
  PROPRIETARIO
  FUNCIONARIO
}

model Usuario {
  id    String  @id @default(uuid())
  nome  String?
  email String  @unique
  senha String

  // Perfil dentro da empresa — controla quem pode mexer na aba
  // Colaboradores (só ADMIN, ou o isAdminMaster). Default ADMIN pra não
  // tirar acesso de contas que já existiam antes desse campo existir.
  perfil PerfilUsuario @default(ADMIN)

  // Dono do sistema (você) — vê o Quadro do Administrador e todas as
  // empresas. Não é um perfil por empresa, é uma flag separada; só quem
  // já é isAdminMaster consegue marcar outro usuário como tal (não dá pra
  // promover a si mesmo pelo Quadro).
  isAdminMaster Boolean @default(false)

  // Login desativado individualmente (sem precisar inativar a empresa
  // inteira) — checado igual ao "ativo" da Empresa.
  ativo Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}

model Viagem {
  id         String   @id @default(uuid())
  mes        String
  quantidade Int
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  createdAt  DateTime @default(now())
}

model ConfiguracaoPagamento {
  id             String @id @default(uuid())
  empresaId      String
  salarioBase    Float // 3352
  valorDiaria    Float // 200
  valorPorViagem Float // 150
  bonus7Viagens  Float // 1500
  bonusPadrao    Float? // 0, 500 ou 1000

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

enum TipoCalculoPagamento {
  TRADICIONAL
  FATURAMENTO
}

model ConfiguracaoPagamentoCaminhao {
  id String @id @default(uuid())

  caminhaoId String   @unique
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)

  tipoCalculo TipoCalculoPagamento @default(TRADICIONAL)

  percentualFaturamento Float   @default(2)
  valorDiariaOverride   Float?
  ativo                 Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoPagamentoMotorista {
  id String @id @default(uuid())

  // Adicionado no retrofit de isolamento por empresa — antes desse campo
  // existia só UMA config no sistema inteiro, compartilhada por todas as
  // empresas (bug, não era intencional). Fica opcional só pra não quebrar
  // a linha antiga (órfã) que já existe; toda empresa nova recebe sua
  // própria linha na primeira vez que mexe na tela.
  empresaId String?  @unique
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  salarioBase      Float @default(3352)
  valorDiaria      Float @default(200)
  valorPorViagem   Float @default(150)
  bonusMetaViagens Float @default(1500)
  metaViagens      Int   @default(7)
  diasBaseSalario  Int   @default(30)

  adiantamento Float @default(3000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RelatorioPagamento {
  id  String @id @default(uuid())
  mes String

  valorViagens   Float
  valorDias      Float
  descontoParado Float
  total          Float

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([caminhaoId, mes])
}

model TruckStatus {
  id String @id @default(uuid())

  caminhaoId String   @unique
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  ultimaCidade String
  ultimaData   DateTime

  estado String
  // 'parado' | 'em_viagem' | 'livre'

  // Estado da máquina de viagens/paradas no fim do último upload
  // processado, pra continuar corretamente no mês seguinte (ex: se o
  // caminhão fechou o mês parado em Betim, o próximo upload precisa saber
  // que a parada já estava aberta desde essa data, e não começar do zero).
  localConfirmado   String? // 'BETIM' | 'POUSO_ALEGRE' | 'SANTOS' | null
  paradaAbertaDesde DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UploadPeriod {
  id         String   @id @default(uuid())
  periodo    String
  dataInicio DateTime
  dataFim    DateTime
  createdAt  DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadId String?
  upload   Upload? @relation(fields: [uploadId], references: [id])

  trips TripRecord[]
  stops StopRecord[]

  @@unique([caminhaoId, periodo])
}

model TripRecord {
  id              String   @id @default(uuid())
  dataHoraChegada DateTime
  cidade          String
  latitude        String?
  createdAt       DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadPeriodId String
  uploadPeriod   UploadPeriod @relation(fields: [uploadPeriodId], references: [id], onDelete: Cascade)
}

model StopRecord {
  id String @id @default(uuid())

  dataHoraEntrada DateTime
  dataHoraSaida   DateTime?
  diasParados     Int       @default(0)

  cidadeEntrada   String
  latitudeEntrada String?

  cidadeSaida   String?
  latitudeSaida String?

  createdAt DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadPeriodId String
  uploadPeriod   UploadPeriod @relation(fields: [uploadPeriodId], references: [id], onDelete: Cascade)
}

enum DirecaoTransacaoFinanceira {
  ENTRADA
  SAIDA
}

enum StatusTransacaoFinanceira {
  PENDENTE_CLASSIFICACAO
  CLASSIFICADA
  IGNORADA
}

model CategoriaFinanceira {
  id    String  @id @default(uuid())
  nome  String
  ativo Boolean @default(true)

  // Retrofit de isolamento por empresa — antes "nome" era único no sistema
  // inteiro, então duas empresas não conseguiam ter as duas uma categoria
  // "Combustível", por exemplo. Fica opcional só pra não quebrar linhas
  // antigas (órfãs); categorias novas sempre vêm com empresaId.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transacoes TransacaoFinanceira[]
  regras     RegraClassificacaoFinanceira[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model ImportacaoExtrato {
  id               String   @id @default(uuid())
  nomeArquivo      String
  totalLinhas      Int      @default(0)
  linhasImportadas Int      @default(0)
  linhasIgnoradas  Int      @default(0)
  createdAt        DateTime @default(now())

  // Opcional por retrofit (ver Caminhao.empresaId) — toda importação nova
  // sempre grava a empresa de quem importou.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  transacoes TransacaoFinanceira[]

  @@index([empresaId])
}

model TransacaoFinanceira {
  id String @id @default(uuid())

  data        DateTime
  lancamento  String
  razaoSocial String?
  documento   String?
  descricao   String?
  valor       Decimal  @db.Decimal(10, 2)

  direcao DirecaoTransacaoFinanceira
  status  StatusTransacaoFinanceira  @default(PENDENTE_CLASSIFICACAO)

  caminhaoId String?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])

  importacaoId String?
  importacao   ImportacaoExtrato? @relation(fields: [importacaoId], references: [id], onDelete: SetNull)

  // Opcional por retrofit (ver Caminhao.empresaId) — toda transação nova
  // (vinda de um import) sempre grava a empresa de quem importou.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  observacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
  @@index([direcao])
  @@index([caminhaoId])
  @@index([categoriaId])
  @@index([empresaId])
}

// Lista de veículos vinda da API de rastreamento (trucks-control) —
// RequestVeiculo só pode ser chamado a cada 5 minutos, e antes disso a
// gente guardava a lista só em memória, então todo restart do backend
// zerava tudo e ficava "Nenhum caminhão encontrado" até passar os 5
// minutos. Agora fica salva aqui, e o cache em memória é só otimização.
// Credencial da conta que a empresa tem na Trucks Control — cada empresa
// tem seu próprio login/senha, então cada uma só enxerga os caminhões
// cadastrados na sua conta de rastreamento. Senha cifrada com o mesmo
// esquema AES-256-GCM do certificado digital (CERT_ENCRYPTION_KEY),
// nunca gravada em texto puro nem devolvida pra tela depois de salva.
model TrucksControlCredencial {
  id        String  @id @default(uuid())
  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  login String

  senhaCifrada String
  senhaIv      String
  senhaAuthTag String

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VeiculoTrucksControl {
  id String @id @default(uuid())

  // Cada empresa consulta a própria conta na Trucks Control, então o
  // mesmo veiId poderia em tese existir em contas diferentes — por isso a
  // unicidade é por empresa, não mais global. Nullable só pra permitir a
  // migração sem quebrar as linhas que já existiam antes do retrofit
  // multi-empresa (registros órfãos, de quando só existia uma conta pro
  // sistema inteiro) — todo registro novo sempre vem com empresaId
  // preenchido.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiId Int

  placa         String?
  equipamento   Int?
  motorista     String?
  proprietario  Boolean?
  identificacao String?
  chassi        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, veiId])
  @@index([empresaId])
}

// Guarda a hora da última chamada feita a cada tipo de requisição da
// Trucks Control (RequestVeiculo, RequestMensagemCB...), persistida no
// banco em vez de só em memória. A API tem um intervalo mínimo entre
// chamadas do mesmo login (ela conta o tempo do lado dela, não do nosso
// processo) — sem isso, cada reinício do backend em desenvolvimento
// (start:dev reinicia a cada salvamento) zera o controle em memória e
// tenta chamar de novo na hora, mesmo que a chamada anterior tenha sido há
// poucos segundos, e a API rejeita com "código 7 — não atingiu o tempo
// mínimo pra reenvio". Agora por empresa, porque cada uma usa um login
// diferente e tem sua própria janela de espera com a Trucks Control.
model TrucksControlRateLimit {
  id        String   @id @default(uuid())
  // Nullable pelo mesmo motivo do VeiculoTrucksControl acima — registros
  // órfãos de antes do retrofit multi-empresa ficam parados aqui sem
  // atrapalhar; toda chamada nova já grava com empresaId.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  tipoRequisicao  String
  ultimaChamadaEm DateTime
  updatedAt       DateTime @updatedAt

  @@unique([empresaId, tipoRequisicao])
}

// Histórico de posições dos caminhões vindas da API de rastreamento
// (trucks-control). A API externa só guarda mensagens por pouco tempo
// (fila de mensagens não lidas, perdida em poucas horas), então isso
// aqui é a fonte confiável pra consultar rotas passadas — o cron do
// TrucksControlService vai salvando os pings novos aqui a cada poucos
// minutos, além do que a tela ao vivo já busca.
model PosicaoCaminhao {
  id String @id @default(uuid())

  // ID da mensagem na API externa — usado pra não salvar duplicado.
  // BigInt porque a Trucks Control usa uma numeração global (parece
  // compartilhada entre todos os clientes dela), que já passa de 185
  // bilhões — muito maior que o limite de um Int de 32 bits (~2,1 bi).
  // Continua único globalmente mesmo com o retrofit multi-empresa,
  // porque esse número já é compartilhado entre contas diferentes.
  mId BigInt @unique

  // Empresa dona da conta que gerou esse ping — só pra filtrar a tela de
  // rastreamento por empresa; não faz parte da unicidade (mId já garante).
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiId Int
  placa String?

  dataHora DateTime

  latitude  Float
  longitude Float

  municipio String?
  uf        String?
  rua       String?
  rodovia   String?

  velocidade Float?
  motorista  String?

  // Campos que a API da Trucks Control já manda dentro de RequestMensagemCB
  // (junto com cada ping de posição) mas que até agora não eram lidos nem
  // salvos — só passaram a ser gravados a partir daqui pra frente; pings
  // antigos ficam com esses campos null.
  litrosTanque Float? // "lt" — nível de combustível no tanque, se o veículo tiver o sensor
  odometro     Float? // "odm" — odômetro do veículo
  rpm          Int? // "rpm" — rotação do motor no momento do ping

  createdAt DateTime @default(now())

  @@index([placa, dataHora])
  @@index([veiId, dataHora])
  @@index([empresaId])
}

// Ocorrências de Telemetria (RequestTelemetriaOcorrenciasHoje) — uma linha
// por minuto/evento de CAN do veículo, com o percentual do tanque
// (pTanque) e do pedal do acelerador (pAcelerador). É o dado real de nível
// de combustível "ao vivo" — diferente do "lt" de RequestMensagemCB
// (PosicaoCaminhao.litrosTanque), que segundo o suporte da Trucks Control
// não vem preenchido de verdade; pTanque é a fonte confiável, mas só
// funciona se a empresa tiver telemetria habilitada no plano e embarcada
// no equipamento (ver RequestEmbarcarTelemetria no manual). Só existe
// "hoje" no nome da requisição porque a API só devolve ocorrências do dia
// corrente — por isso persistimos aqui pra manter histórico.
model TelemetriaOcorrencia {
  id String @id @default(uuid())

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiId Int
  placa String?

  dataHora DateTime

  velocidade    Float? // "vel" — velocidade aferida na ocorrência
  velocidadeMax Float? // "velMax" — velocidade máxima atingida na ocorrência
  rpm           Int? // "rpm" — RPM atingido na ocorrência

  // Percentual do nível do tanque (0-100), não litros absolutos — é assim
  // que a Trucks Control manda esse dado por telemetria/CAN.
  percentualTanque     Float? // "pTanque"
  percentualAcelerador Float? // "pAcelerador"

  createdAt DateTime @default(now())

  // Sem @unique por mId (essa requisição não tem um ID de mensagem igual
  // MensagemCB) — dedup é feito na aplicação por veiId+dataHora antes do
  // upsert.
  @@unique([veiId, dataHora])
  @@index([placa, dataHora])
  @@index([empresaId])
}

// Blocos de Telemetria V2.5 (RequestTelemetriaV25) — consumo de
// combustível de verdade (litros consumidos no bloco), hodômetro e
// horímetro, agregados em blocos de tempo (não é um ping por minuto como
// a Ocorrência acima). Essa é a fonte pra "quantos litros o caminhão
// gastou", enquanto TelemetriaOcorrencia.percentualTanque é "quanto ainda
// tem no tanque agora".
model TelemetriaBlocoV25 {
  id String @id @default(uuid())

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  veiId Int
  placa String?

  dataHoraInicio DateTime
  dataHoraFim    DateTime

  hodometroInicial Float? // "HodometroInicial"
  hodometroTotal   Float? // "HodometroTotal" — hodômetro aferido no fechamento do bloco

  qtdMinutosMotorInicio Int? // "QtdMinutosMotorInicio" — horímetro inicial, em minutos
  qtdMinutosMotorFim    Int? // "QtdMinutosMotorFim" — horímetro final, em minutos

  consumoLitrosAnterior Float? // "ConsumoLitrosAnterior" — consumo que finalizou o bloco anterior
  consumoLitros         Float? // "ConsumoLitros" — consumo do bloco atual

  tempMediaLiqArrefecimento  Float? // "TempMediaLiqArrefecimento"
  tempMaximaLiqArrefecimento Float? // "TempMaximaLiqArrefecimento"

  createdAt DateTime @default(now())

  @@unique([veiId, dataHoraInicio, dataHoraFim])
  @@index([placa, dataHoraFim])
  @@index([empresaId])
}

enum StatusViagemGps {
  EM_ANDAMENTO
  CONCLUIDA
}

// Viagem detectada automaticamente pelo rastreamento GPS (trucks-control) —
// diferente do model "Viagem" (contagem manual mensal ligada a pagamento) e
// de TripRecord/StopRecord (vindos de upload de planilha). Essa aqui nasce
// quando o caminhão sai da região do porto de Santos e é fechada quando ele
// chega em Betim ou Pouso Alegre. Não alimenta nenhum cálculo de pagamento
// — é só rastreamento operacional pro Dashboard.
model ViagemGps {
  id String @id @default(uuid())

  // Igual ao PosicaoCaminhao.empresaId — filtra a tela de Viagens por
  // empresa; opcional porque viagens antigas foram detectadas antes do
  // retrofit multi-empresa e ainda não têm dono.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Nula quando a viagem é de terceiro (caminhão sem cadastro na Trucks
  // Control) — nesse caso não tem rastreamento GPS nem conclusão
  // automática, só a placa digitada na hora de criar.
  veiId Int?
  placa String?

  // Viagem feita por caminhão de terceiro/agregado (não é da frota
  // própria rastreada pela Trucks Control) — usado pra destacar/separar
  // essas viagens das próprias nas telas de Viagens.
  terceiro Boolean @default(false)

  origemMunicipio String
  origemUf        String?
  dataHoraInicio  DateTime

  destinoMunicipio String?
  destinoUf        String?
  dataHoraFim      DateTime?

  status StatusViagemGps @default(EM_ANDAMENTO)

  // Viagem criada manualmente por alguém do administrativo (botão "Nova
  // Viagem"), em vez de detectada sozinha pelo GPS saindo de Santos. Nesse
  // caso origemMunicipio/destinoMunicipio já vêm preenchidos na criação
  // (não só quando a viagem termina) — a conclusão automática compara a
  // posição atual do caminhão com destinoMunicipio, e não com a lista fixa
  // de cidades (Betim/Pouso Alegre) usada pelas viagens automáticas.
  criadaManualmente Boolean @default(false)

  // Coordenadas de origem/destino (geocodificadas a partir do nome da
  // cidade na criação da viagem manual) — usadas só pra calcular a barra
  // de progresso ("está chegando ou não"); a conclusão em si não depende
  // delas, só do nome do município bater. Ficam null se a viagem for
  // automática ou se a geocodificação falhar.
  origemLatitude   Float?
  origemLongitude  Float?
  destinoLatitude  Float?
  destinoLongitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([veiId, status])
  @@index([placa])
  @@index([empresaId])
  @@index([empresaId, terceiro])
}

model RegraClassificacaoFinanceira {
  id      String @id @default(uuid())
  palavra String

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])

  caminhaoId String?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  // Opcional por retrofit (ver Caminhao.empresaId) — toda regra nova
  // sempre grava a empresa de quem criou.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  ativo      Boolean @default(true)
  prioridade Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([palavra])
  @@index([empresaId])
}

// =========================================================================
// Módulo Fiscal — RPA / CIOT / preparação de CT-e e MDF-e.
//
// A empresa roda tanto viagens PRÓPRIAS (caminhão dela, responsável pelo
// frete — exige CT-e e, a partir daí, MDF-e) quanto viagens AGREGADAS
// (transportando sob o CT-e de outra transportadora, pagando motorista
// autônomo — exige CIOT + comprovante de pagamento tipo RPA).
//
// RPA e CIOT são registros reais, gerados/controlados por aqui. CT-e e
// MDF-e ainda não são emitidos de verdade pelo sistema (dependem de
// credenciamento externo na Sefaz/ANTT que a empresa ainda não confirmou
// ter concluído) — por enquanto é só um checklist de preparação
// (FiscalPreparoItem), pra não arriscar emitir documento fiscal inválido.
// =========================================================================

enum StatusRpa {
  PENDENTE
  PAGO
}

// Recibo de Pagamento Autônomo — comprovante interno de pagamento a
// motorista autônomo/agregado por uma viagem ou período, com retenção de
// INSS (11%, teto do INSS) e IRRF (tabela progressiva) já calculadas.
// Não é um documento fiscal eletrônico (não tem webservice de autorização);
// idealmente é reportado à parte via eSocial (S-2300/S-1200), fora do
// escopo deste módulo por enquanto.
model RpaRecibo {
  id String @id @default(uuid())

  // Adicionado junto do retrofit de empresa do módulo Financeiro/NF —
  // opcional por enquanto (registros antigos ficam sem empresa até
  // backfill), mas é o que permite filtrar RPA por empresa mesmo quando
  // não há caminhaoId (motorista avulso, sem viagem vinculada).
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  motoristaNome String
  motoristaCpf  String?
  motoristaPix  String?

  caminhaoId String?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  competencia      String // 'YYYY-MM'
  descricaoServico String? // ex: "Frete Santos -> Betim, 12 a 15/09"

  valorBruto   Float
  aliquotaInss Float @default(11) // %
  valorInss    Float @default(0)
  baseIrrf     Float @default(0)
  aliquotaIrrf Float @default(0) // %
  valorIrrf    Float @default(0)
  valorLiquido Float

  status         StatusRpa @default(PENDENTE)
  dataPagamento  DateTime?
  formaPagamento String?

  observacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competencia])
  @@index([status])
  @@index([caminhaoId])
  @@index([empresaId])
}

enum StatusCiot {
  PENDENTE
  EMITIDO
  CANCELADO
}

// Registro de CIOT (Código Identificador da Operação de Transporte) —
// obrigatório ao contratar motorista autônomo/TAC pra frete agregado.
// A emissão real depende de integração com um IPEF credenciado na ANTT
// (Strada Pay, Repom, Roadcard, SEM PARAR Frete etc.) — a empresa ainda
// não escolheu/contratou um, então por enquanto isso aqui é um registro
// manual de controle (pra não perder o prazo/obrigação de nenhuma
// viagem agregada), já pronto pra guardar o número do CIOT assim que for
// gerado, aqui ou numa integração futura com o IPEF escolhido.
model CiotRegistro {
  id String @id @default(uuid())

  // Mesmo motivo do RpaRecibo.empresaId acima.
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  numeroCiot String?
  operadora  String? // ex: "Strada Pay", "Repom", "Roadcard"...

  caminhaoId String?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  motoristaNome String
  motoristaCpf  String?

  origemMunicipio  String
  destinoMunicipio String
  dataViagem       DateTime

  valorFrete Float?

  status      StatusCiot @default(PENDENTE)
  dataEmissao DateTime?

  observacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([caminhaoId])
  @@index([empresaId])
}

enum TipoPreparoFiscal {
  CTE
  MDFE
}

// Checklist de pré-requisitos pra emissão real de CT-e/MDF-e (RNTRC ativo,
// credenciamento na Sefaz, certificado digital, etc.) — o sistema não
// emite esses documentos ainda, só ajuda a acompanhar o que falta. Os
// itens de cada tipo são criados automaticamente (seed) na primeira
// consulta, se ainda não existirem.
// =========================================================================
// Módulo Financeiro/NF — espelha o fluxo do Controle NF (NuGalho Hub), mas
// escopado por Empresa (em vez de Store) e com vínculo opcional a Caminhão
// (em vez de Purchase/Service): NF de Entrada (mercadoria) e NF de Serviço
// chegam via sync automático na Sefaz/ADN usando o certificado digital A1
// da empresa; ao "aceitar" uma NF, o usuário escolhe gerar Conta a Pagar
// na hora ou só marcar como conciliada. Fornecedor e Categoria são
// digitáveis com criação automática, igual ao Controle NF.
// =========================================================================

model Fornecedor {
  id              String  @id @default(uuid())
  nome            String
  nomeNormalizado String
  cnpj            String?
  telefone        String?
  ativo           Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contasPagar ContaPagar[]

  @@unique([empresaId, nomeNormalizado])
  @@index([empresaId])
}

// Categoria livre da conta a pagar (ex.: Peças, Combustível, Pedágio,
// Manutenção...) — digitada na hora e criada automaticamente se não
// existir, igual Fornecedor.
model CategoriaContaPagar {
  id              String  @id @default(uuid())
  nome            String
  nomeNormalizado String
  ativo           Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contasPagar ContaPagar[]

  @@unique([empresaId, nomeNormalizado])
  @@index([empresaId])
}

enum TipoContaPagar {
  BOLETO
  PIX
  CARTAO
  SEM_BOLETO
}

enum StatusContaPagar {
  ABERTA
  PAGA
  VENCIDA
  CANCELADA

  // Já recebeu alguma baixa (PagamentoContaPagar) mas a soma ainda não
  // cobre o valor total — ex: dívida de 5000, pagou 3000, faltam 2000.
  // Calculado/gravado junto com cada baixa (ver registrarPagamento no
  // service); vira PAGA sozinho quando a soma das baixas alcança o valor.
  PARCIAL
}

enum FormaPagamentoContaPagar {
  BOLETO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  TRANSFERENCIA
  CONTA_EMPRESA
}

enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

model ContaPagar {
  id        String @id @default(uuid())
  descricao String
  valor     Float

  tipo           TipoContaPagar           @default(BOLETO)
  formaPagamento FormaPagamentoContaPagar @default(BOLETO)

  vencimento DateTime
  pagoEm     DateTime?

  status StatusContaPagar @default(ABERTA)

  codigoBarras String?

  pixChave     String?
  pixTipoChave TipoChavePix?
  pixQrCode    String?

  banco      String?
  agencia    String?
  conta      String?
  favorecido String?

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  categoriaId String?
  categoria   CategoriaContaPagar? @relation(fields: [categoriaId], references: [id])

  caminhaoId String?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  arquivoUrl              String?
  comprovantePagamentoUrl String?
  observacao              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nfEntradas NfEntrada[] @relation("NfEntradaContaPagar")
  nfServicos NfServico[] @relation("NfServicoContaPagar")

  pagamentos PagamentoContaPagar[]

  @@index([empresaId])
  @@index([fornecedorId])
  @@index([categoriaId])
  @@index([caminhaoId])
  @@index([status])
  @@index([vencimento])
}

// Baixa (total ou parcial) de uma ContaPagar. Uma dívida de 5000 pode
// receber duas baixas de 3000 e 2000 em dias diferentes — a ContaPagar
// continua sendo UM registro só (mesmo vencimento/fornecedor/histórico),
// só o status/pagoEm são recalculados a partir da soma das baixas (ver
// recalcularStatusContaPagar no service). Isso evita duplicar a dívida em
// duas contas separadas, o que quebraria relatórios por fornecedor/mês.
model PagamentoContaPagar {
  id String @id @default(uuid())

  contaPagarId String
  contaPagar   ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)

  valor          Float
  data           DateTime
  formaPagamento FormaPagamentoContaPagar?
  observacao     String?

  createdAt DateTime @default(now())

  @@index([contaPagarId])
}

enum TipoLancamentoCaminhao {
  RECEITA
  DESPESA
}

// Lançamento manual de receita/despesa por caminhão, pra tela de Caminhões
// (comparativo receita x despesa). Guardado pela PLACA (texto), não por
// caminhaoId — caminhões de terceiros não têm cadastro em Caminhao (só
// existem como texto livre em ViagemGps.placa quando terceiro=true), então
// amarrar pela placa deixa o lançamento funcionar pra frota própria e pra
// terceiros sem exigir cadastro prévio do caminhão.
model LancamentoCaminhao {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  placa String

  tipo      TipoLancamentoCaminhao
  descricao String
  valor     Decimal                @db.Decimal(10, 2)
  data      DateTime               @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId, placa])
  @@index([tipo])
}

// Certificado digital (e-CNPJ) da empresa, usado pra autenticar via mTLS
// nas APIs da Sefaz (NF-e) e ADN (NFS-e nacional). O arquivo .pfx fica fora
// de qualquer pasta servida publicamente e a senha nunca é gravada em
// texto puro — só o resultado da criptografia AES-256-GCM (mesma técnica
// do Controle NF), cifrada com CERT_ENCRYPTION_KEY.
model CertificadoDigitalEmpresa {
  id        String  @id @default(uuid())
  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nomeArquivo    String
  caminhoArquivo String

  senhaCifrada String
  senhaIv      String
  senhaAuthTag String

  // Cursor da distribuição de documentos da Sefaz (NSU = Número Sequencial
  // Único) pra NFS-e (ADN). Cada busca continua daqui em vez de reprocessar
  // tudo de novo.
  ultimoNsu BigInt @default(0)

  // Cursor separado pra distribuição de NF-e de mercadoria (webservice
  // NFeDistribuicaoDFe) — sistema totalmente diferente do ADN acima, com
  // numeração de NSU própria; não pode compartilhar o mesmo cursor.
  ultimoNsuNfe BigInt @default(0)

  // Até quando NÃO vale a pena tentar sincronizar de novo (Sefaz/ADN pedem
  // espera depois de "nada de novo" ou bloqueio por "consumo indevido").
  // Null = sem bloqueio conhecido no momento.
  nfeBloqueadoAte  DateTime?
  nfseBloqueadoAte DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Registro de cada tentativa de buscar documentos fiscais na Sefaz/ADN —
// manual ou automática (job agendado) — pra dar visibilidade a erros que
// aconteceriam sem ninguém olhando.
model SefazSincronizacaoLog {
  id        String  @id @default(uuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // 'NFE_ENTRADA' (mercadoria, via Sefaz) ou 'NFSE_SERVICO' (via ADN).
  origem String

  sucesso      Boolean
  mensagem     String
  totalBuscado Int     @default(0)

  createdAt DateTime @default(now())

  @@index([empresaId, origem, createdAt])
}

enum OrigemNf {
  SEFAZ
  XML_UPLOAD
}

// Documento fiscal baixado da distribuição da Sefaz (NF-e de mercadoria
// destinada ao CNPJ da empresa) que ainda não foi conciliado. A resposta
// padrão do distDFeInt é só o "resumo" (resNFe) — por isso já guardamos
// emitente/valor/data extraídos dali. caminhaoId só é preenchido se o
// usuário decidir vincular a NF a um caminhão específico (ex.: peça,
// pneu, manutenção); pode ficar solta na empresa (despesa geral).
model NfEntrada {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nsu           BigInt
  chaveAcesso   String
  tipoDocumento String // resNFe | resEvento | resCancNFe | procNFe etc.

  emitenteCnpj String?
  emitenteNome String?
  valor        Float?
  dataEmissao  DateTime?
  situacao     String? // cSitNFe do resumo: autorizada, cancelada, etc.
  numeroNf     String? // ide.nNF do XML completo (só disponível quando tipoDocumento é procNFe)

  // Destinatário da NF-e, extraído do XML completo (procNFe). Usado pra
  // detectar "NF de carga": como a empresa é transportadora, ela recebe
  // via distribuição da Sefaz notas em que só aparece no grupo <transp>
  // (transportando a mercadoria de terceiro) — não é compra própria.
  // ehCarga = destinatário preenchido e diferente do CNPJ da empresa
  // (inclui destinatário estrangeiro, que nunca bate com o nosso CNPJ).
  destinatarioCnpj String?
  destinatarioNome String?
  ehCarga          Boolean @default(false)

  arquivoUrl String?
  buscadoEm  DateTime @default(now())

  // Manifestação do destinatário (Ciência da Operação) — enviada
  // automaticamente pro documento que chegou como resumo, pra Sefaz
  // liberar o XML completo (com itens) na próxima consulta.
  manifestadoEm      DateTime?
  statusManifestacao String?

  origem OrigemNf @default(SEFAZ)

  caminhaoId String?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  ignorado Boolean @default(false) // marcado como "não é nossa"/recusado

  // Aceita direto: accepted = aceita sem gerar conta, contaPagarId =
  // aceita e a conta a pagar foi criada direto a partir dessa NF.
  aceita       Boolean     @default(false)
  contaPagarId String?
  contaPagar   ContaPagar? @relation("NfEntradaContaPagar", fields: [contaPagarId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, chaveAcesso])
  @@index([empresaId])
  @@index([caminhaoId])
  @@index([tipoDocumento])
  @@index([contaPagarId])
  @@index([ehCarga])
}

// Documento fiscal baixado da distribuição do ADN (NFS-e nacional) para o
// CNPJ da empresa (contratação de serviço). Diferente da NfEntrada, o ADN
// entrega o XML completo, por isso os campos estruturados abaixo já vêm
// preenchidos na captura.
model NfServico {
  id String @id @default(uuid())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nsu           BigInt
  chaveAcesso   String
  tipoDocumento String
  tipoEvento    String?

  numeroNf      String?
  prestadorNome String? // nome do prestador do serviço
  prestadorDoc  String? // CNPJ/CPF do prestador
  valor         Float?
  dataEmissao   DateTime?

  arquivoUrl String?
  geradoEm   DateTime?
  buscadoEm  DateTime  @default(now())

  caminhaoId String?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  ignorado Boolean @default(false) // marcado como "não é nossa"/recusado

  aceita       Boolean     @default(false)
  contaPagarId String?
  contaPagar   ContaPagar? @relation("NfServicoContaPagar", fields: [contaPagarId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, chaveAcesso])
  @@index([empresaId])
  @@index([caminhaoId])
  @@index([tipoDocumento])
  @@index([contaPagarId])
}

model FiscalPreparoItem {
  id String @id @default(uuid())

  tipo      TipoPreparoFiscal
  chave     String // identificador fixo do item, ex: 'rntrc_ativo'
  titulo    String
  descricao String?
  ordem     Int               @default(0)

  concluido   Boolean   @default(false)
  concluidoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, chave])
}
