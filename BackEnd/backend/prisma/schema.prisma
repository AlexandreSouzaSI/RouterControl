generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TruckRule {
  id         String @id @default(uuid())
  caminhaoId String @unique

  origemViagem  String?
  destinoViagem String?
  cidadeParado  String?

  caminhao Caminhao @relation(fields: [caminhaoId], references: [id])
}

model Upload {
  id          String   @id @default(uuid())
  nomeArquivo String
  mes         String
  createdAt   DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadPeriods UploadPeriod[]

  resumos ResumoOperacao[]
}

model Caminhao {
  id    String  @id @default(uuid())
  ativo Boolean @default(true)
  placa String  @unique

  uploadPeriods UploadPeriod[]
  tripRecords   TripRecord[]
  stopRecords   StopRecord[]
  resumos             ResumoOperacao[]
  relatorioPagamentos RelatorioPagamento[]
  truckRules          TruckRule[]
  Upload              Upload[]

  truckStatus TruckStatus?
  configPagamento ConfiguracaoPagamentoCaminhao?  
}

model ResumoOperacao {
  id            String   @id @default(uuid())
  mes           String
  numeroViagens Int
  diasParados   Int
  diasRodando   Int
  createdAt     DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadId String?
  upload   Upload? @relation(fields: [uploadId], references: [id])
}

model Motorista {
  id    String  @id @default(uuid())
  nome  String
  ativo Boolean @default(true)
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  createdAt DateTime @default(now())

  usuarios               Usuario[]
  viagens                Viagem[]
  configuracaoPagamentos ConfiguracaoPagamento[]
}

model Usuario {
  id        String  @id @default(uuid())
  email     String  @unique
  senha     String
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
}

model Viagem {
  id         String   @id @default(uuid())
  mes        String
  quantidade Int
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  createdAt  DateTime @default(now())
}

model ConfiguracaoPagamento {
  id             String @id @default(uuid())
  empresaId      String
  salarioBase    Float // 3352
  valorDiaria    Float // 200
  valorPorViagem Float // 150
  bonus7Viagens  Float // 1500
  bonusPadrao    Float? // 0, 500 ou 1000

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

enum TipoCalculoPagamento {
  TRADICIONAL
  FATURAMENTO
}

model ConfiguracaoPagamentoCaminhao {
  id String @id @default(uuid())

  caminhaoId String @unique
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id], onDelete: Cascade)

  tipoCalculo TipoCalculoPagamento @default(TRADICIONAL)

  percentualFaturamento Float @default(2)
  valorDiariaOverride   Float?
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfiguracaoPagamentoMotorista {
  id String @id @default(uuid())

  salarioBase       Float @default(3352)
  valorDiaria       Float @default(200)
  valorPorViagem    Float @default(150)
  bonusMetaViagens  Float @default(1500)
  metaViagens       Int   @default(7)
  diasBaseSalario   Int   @default(30)

  adiantamento Float @default(3000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RelatorioPagamento {
  id  String @id @default(uuid())
  mes String

  valorViagens   Float
  valorDias      Float
  descontoParado Float
  total          Float

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([caminhaoId, mes])
}

model TruckStatus {
  id String @id @default(uuid())

  caminhaoId String @unique
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  ultimaCidade String
  ultimaData   DateTime

  estado String 
  // 'parado' | 'em_viagem' | 'livre'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UploadPeriod {
  id        String   @id @default(uuid())
  periodo   String
  dataInicio DateTime
  dataFim    DateTime
  createdAt DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadId String?
  upload   Upload? @relation(fields: [uploadId], references: [id])

  trips TripRecord[]
  stops StopRecord[]

  @@unique([caminhaoId, periodo])
}

model TripRecord {
  id              String   @id @default(uuid())
  dataHoraChegada DateTime
  cidade          String
  latitude        String?
  createdAt       DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadPeriodId String
  uploadPeriod   UploadPeriod @relation(fields: [uploadPeriodId], references: [id], onDelete: Cascade)
}

model StopRecord {
  id String @id @default(uuid())

  dataHoraEntrada DateTime
  dataHoraSaida   DateTime?
  diasParados     Int @default(0)

  cidadeEntrada   String
  latitudeEntrada String?

  cidadeSaida     String?
  latitudeSaida   String?

  createdAt DateTime @default(now())

  caminhaoId String
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  uploadPeriodId String
  uploadPeriod   UploadPeriod @relation(fields: [uploadPeriodId], references: [id], onDelete: Cascade)
}
