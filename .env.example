# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e
# preencha com os valores reais antes de rodar `docker compose up -d --build`.
# O arquivo ".env" real NUNCA deve ir pro Git.

# Senha do Postgres usado pelo Controle Rota (pode manter "postgres" se
# o banco só for acessado de dentro da rede interna do Docker).
POSTGRES_PASSWORD=postgres

# Chave usada pra assinar os tokens de login — gere uma string aleatória
# forte (ex: openssl rand -base64 48) e nunca reaproveite a de dev.
JWT_SECRET=

# Credenciais da API de rastreamento (Trucks Control / New Rastreamento).
TRUCKS_URL=https://webservice.newrastreamentoonline.com.br
TRUCKS_LOGIN=
TRUCKS_SENHA=

# URL pública do backend, usada pelo frontend em tempo de build (fica
# embutida no JS gerado pelo Vite — precisa ser a URL final com HTTPS).
VITE_API_URL=https://api-controlerota.amsx.online
